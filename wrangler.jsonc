{
  // Cloudflare : ce dépôt déploie le relais de l'app Tickets (cours de bourse et foyer partagé)
  // (l'app elle-même reste publiée par GitHub Pages).
  "name": "tickets",
  "main": "relais/cours-worker.js",
  "compatibility_date": "2025-01-01",
  "workers_dev": true,
  // Foyer partagé : un Durable Object par foyer, stockage SQLite (offre gratuite)
  "durable_objects": {
    "bindings": [{ "name": "FOYER", "class_name": "Foyer" }, { "name": "GARDE", "class_name": "Garde" }]
  },
  // Limites par adresse (21/11), tenues par Cloudflare dans chaque lieu (gratuit) : requêtes /foyer, essais de « rejoindre », cours.
  // Les mêmes valeurs servent de repli dans le code (RL_FOYER, RL_JOIN dans foyer.js ; RL_MAX dans cours-worker.js) : les changer ensemble.
  "ratelimits": [
    { "name": "RL_F", "namespace_id": "2101", "simple": { "limit": 300, "period": 60 } },
    { "name": "RL_J", "namespace_id": "2102", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_C", "namespace_id": "2103", "simple": { "limit": 120, "period": 60 } }
  ],
  // v2 (07/11) : Garde compte les créations de foyer par jour (contre les abus)
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Foyer"] }, { "tag": "v2", "new_sqlite_classes": ["Garde"] }]
}
