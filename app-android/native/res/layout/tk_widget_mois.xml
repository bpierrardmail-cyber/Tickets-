<?xml version="1.0" encoding="utf-8"?>
<!-- Widget 4×2 : dépenses du mois, budget et 3 plus grosses catégories -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tk_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/tk_widget_bg"
    android:orientation="vertical"
    android:paddingStart="15dp"
    android:paddingEnd="15dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tk_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Dépensé en octobre"
            android:textColor="#ECEEF3"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tk_right"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="budget 1 200 €"
            android:textColor="#A4AAB6"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tk_big"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="28sp"
            android:autoSizeMinTextSize="16sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:text="870,10 €"
            android:textColor="#ECEEF3"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tk_right2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:text="73 % · 51,18 €/jour"
            android:textColor="#A4AAB6"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/tk_bar"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:layout_marginTop="4dp"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />

    <ImageView
        android:id="@+id/tk_chart"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:contentDescription="Cumul des dépenses du mois comparé au mois dernier"
        android:minHeight="24dp"
        android:scaleType="fitXY" />

    <TextView
        android:id="@+id/tk_legend"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="— ce mois   - - sept.   ▼ 32 de moins qu'en sept. à cette date"
        android:textColor="#7C828E"
        android:textSize="10sp" />

    <LinearLayout
        android:id="@+id/tk_c1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tk_c1n"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Hygiène et soins"
            android:textColor="#ECEEF3"
            android:textSize="12.5sp" />

        <ImageView
            android:id="@+id/tk_c1b"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:importantForAccessibility="no"
            android:scaleType="fitXY" />

        <TextView
            android:id="@+id/tk_c1v"
            android:layout_width="62dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:maxLines="1"
            android:text="69,98"
            android:textColor="#ECEEF3"
            android:textSize="12.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tk_c2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tk_c2n"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Bricolage"
            android:textColor="#ECEEF3"
            android:textSize="12.5sp" />

        <ImageView
            android:id="@+id/tk_c2b"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:importantForAccessibility="no"
            android:scaleType="fitXY" />

        <TextView
            android:id="@+id/tk_c2v"
            android:layout_width="62dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:maxLines="1"
            android:text="68,21"
            android:textColor="#ECEEF3"
            android:textSize="12.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tk_c3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tk_c3n"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Alimentation"
            android:textColor="#ECEEF3"
            android:textSize="12.5sp" />

        <ImageView
            android:id="@+id/tk_c3b"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:importantForAccessibility="no"
            android:scaleType="fitXY" />

        <TextView
            android:id="@+id/tk_c3v"
            android:layout_width="62dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:maxLines="1"
            android:text="66,35"
            android:textColor="#ECEEF3"
            android:textSize="12.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tk_c4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tk_c4n"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Santé"
            android:textColor="#ECEEF3"
            android:textSize="12.5sp" />

        <ImageView
            android:id="@+id/tk_c4b"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:importantForAccessibility="no"
            android:scaleType="fitXY" />

        <TextView
            android:id="@+id/tk_c4v"
            android:layout_width="62dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:maxLines="1"
            android:text="25,24"
            android:textColor="#ECEEF3"
            android:textSize="12.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tk_c5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tk_c5n"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Maison"
            android:textColor="#ECEEF3"
            android:textSize="12.5sp" />

        <ImageView
            android:id="@+id/tk_c5b"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:importantForAccessibility="no"
            android:scaleType="fitXY" />

        <TextView
            android:id="@+id/tk_c5v"
            android:layout_width="62dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:maxLines="1"
            android:text="12,10"
            android:textColor="#ECEEF3"
            android:textSize="12.5sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
