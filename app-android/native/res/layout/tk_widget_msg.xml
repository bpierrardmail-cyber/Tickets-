<?xml version="1.0" encoding="utf-8"?>
<!-- Widget sans chiffres : première ouverture, ou Tickets Plus nécessaire -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tk_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/tk_widget_bg"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/tk_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="Tickets"
        android:textColor="#ECEEF3"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tk_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:maxLines="3"
        android:text="Ouvre Tickets une fois pour afficher tes chiffres ici."
        android:textColor="#A4AAB6"
        android:textSize="11.5sp" />
</LinearLayout>
