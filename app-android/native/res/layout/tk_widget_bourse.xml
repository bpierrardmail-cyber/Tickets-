<?xml version="1.0" encoding="utf-8"?>
<!-- Widget 4×2 : Bourse du jour (total, variation depuis hier soir, courbe de la journée) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tk_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/tk_widget_bg"
    android:orientation="vertical"
    android:paddingStart="15dp"
    android:paddingEnd="9dp"
    android:paddingTop="8dp"
    android:paddingBottom="9dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tk_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Bourse · aujourd'hui"
            android:textColor="#ECEEF3"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tk_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="maj 14:35"
            android:textColor="#A4AAB6"
            android:textSize="11sp" />

        <ImageView
            android:id="@+id/tk_refresh"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="Mettre à jour"
            android:padding="7dp"
            android:src="@drawable/tk_ic_refresh" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tk_big"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="28sp"
            android:autoSizeMinTextSize="16sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:text="6 865,05 €"
            android:textColor="#ECEEF3"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tk_chg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:text="▲ +42,18 € · +0,62 %"
            android:textColor="#4FD6A0"
            android:textSize="12.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ImageView
        android:id="@+id/tk_chart"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="6dp"
        android:layout_weight="1"
        android:contentDescription="Courbe du portefeuille aujourd'hui"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="6dp"
        android:orientation="horizontal">

        <TextView android:id="@+id/tk_x0" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="start" android:text="8:00" android:textColor="#7C828E" android:textSize="10sp" />
        <TextView android:id="@+id/tk_x1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="12:40" android:textColor="#7C828E" android:textSize="10sp" />
        <TextView android:id="@+id/tk_x2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="17:20" android:textColor="#7C828E" android:textSize="10sp" />
        <TextView android:id="@+id/tk_x3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:text="22:00" android:textColor="#7C828E" android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
