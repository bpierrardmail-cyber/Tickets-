<?xml version="1.0" encoding="utf-8"?>
<!-- Widget 1×1 : bouton Scan, ouvre l'appareil photo de Tickets -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tk_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/tk_scan_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:contentDescription="Scanner un ticket">

    <ImageView
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:importantForAccessibility="no"
        android:src="@drawable/tk_ic_camera" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Scan"
        android:textColor="#0A130F"
        android:textSize="11.5sp"
        android:textStyle="bold" />
</LinearLayout>
